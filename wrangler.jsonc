{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lkwellnesscenter-poc-package",
  "main": "worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "npm run data:cloudflare:prepare", "watch_dir": "src" },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "lkwellnesscenter-poc-package" }],
  "durable_objects": { "bindings": [{ "name": "DEMO_DATA", "class_name": "DemoData" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoData"] }]
}
